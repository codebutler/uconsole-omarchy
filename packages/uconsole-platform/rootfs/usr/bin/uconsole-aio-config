#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "usage: sudo uconsole-aio-config enable|disable|status [cm4|cm5]" >&2
  exit 2
}

action="${1:-}"
target="${2:-}"
file=/boot/uconsole-aio.txt
[[ "${EUID}" -eq 0 || "${action}" == status ]] || { echo "run as root" >&2; exit 1; }

if [[ -z "${target}" && -r /proc/device-tree/compatible ]]; then
  compatible="$(tr '\0' ' ' </proc/device-tree/compatible)"
  [[ "${compatible}" == *bcm2712* ]] && target=cm5 || target=cm4
fi

case "${action}" in
  status)
    cat "${file}" 2>/dev/null || echo "AIO integration disabled"
    ;;
  disable)
    install -Dm0644 /usr/share/uconsole/boot/uconsole-aio.txt "${file}"
    echo "AIO boot integration disabled; configured rail state was not changed"
    ;;
  enable)
    [[ "${target}" == cm4 || "${target}" == cm5 ]] || usage
    {
      echo '# HackerGadgets AIO V2; generated by uconsole-aio-config.'
      echo '# Power rails remain controlled exclusively by aiov2_ctl.'
      echo "[${target}]"
      if [[ "${target}" == cm4 ]]; then
        echo 'dtparam=i2c_arm=on'
        echo 'dtoverlay=i2c-rtc,pcf85063a'
        echo 'enable_uart=1'
        echo 'dtparam=spi=on'
        echo 'dtoverlay=spi1-1cs'
      else
        echo '# Use the AIO V2 PCF85063A instead of the CM5 internal RTC.'
        echo 'dtparam=rtc=off'
        echo 'dtoverlay=i2c-rtc,pcf85063a,i2c_csi_dsi0'
        echo 'dtparam=uart0'
        echo '# Do not enable spi0: GPIO8 is the uConsole panel reset line.'
        echo 'dtoverlay=spi1-1cs'
      fi
      echo '[all]'
    } > "${file}"
    chmod 0644 "${file}"
    echo "AIO boot integration enabled for ${target}; reboot required"
    ;;
  *) usage ;;
esac
